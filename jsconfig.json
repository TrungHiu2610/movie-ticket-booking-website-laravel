{
    "compilerOptions": {
        "target": "ES6",
        "module": "commonjs",
        "allowSyntheticDefaultImports": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"]
        }
    },
    "exclude": [
        "node_modules",
        "vendor",
        "public",
        "storage",
        "bootstrap/cache",
        "resources/views/**/*.blade.php"
    ]
}
